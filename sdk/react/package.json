{
  "name": "@webmind/react",
  "version": "0.1.0",
  "description": "React components and a framework-agnostic client for a self-hosted WebMind server.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./styles.css": "./dist/webmind.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/client.test.mjs test/chart.test.mjs test/richtext.test.mjs test/exports.test.mjs test/render.test.mjs test/placement.test.mjs test/widget.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kowshikramtg/WebMind.git",
    "directory": "sdk/react"
  }
}
