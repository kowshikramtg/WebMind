# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- WebMind --------------------------------------------------------------
# Signs/verifies user tokens issued by your host application (>= 32 chars).
WEBMIND_JWT_SECRET=
# Protects /v1/admin/* endpoints. Leave empty to disable the admin API.
WEBMIND_ADMIN_API_KEY=

# --- Docker Compose ---------------------------------------------------------
POSTGRES_PASSWORD=
# Directory with the website files / documents to index (mounted read-only).
WEBMIND_CONTENT_DIR=./deployments/docker/content
# Public URL that corresponds to WEBMIND_CONTENT_DIR (used for citation links).
WEBMIND_SITE_URL=http://localhost:8000
# Browser origins allowed to call the API directly (comma-free single origin here).
WEBMIND_CORS_ORIGIN=http://localhost:8000

# --- Language model (optional; default "none" = extractive answers) ---------
WEBMIND_LLM_PROVIDER=none
# ollama:     WEBMIND_LLM_MODEL=llama3.1   WEBMIND_LLM_BASE_URL=http://ollama:11434
# openai:     WEBMIND_LLM_MODEL=...        WEBMIND_LLM_BASE_URL=https://api.openai.com/v1
# anthropic:  WEBMIND_LLM_MODEL=claude-opus-5-5
WEBMIND_LLM_MODEL=
WEBMIND_LLM_BASE_URL=
WEBMIND_LLM_API_KEY=
